@startuml modeloDominio

!theme plain
hide empty members
hide circles
skinparam linetype polyline
left to right direction

package MotorEquipos {
  class Programa
  class Equipo 
  class Alumno
  class LiderEquipo
  class Gestor

  Programa *-- Equipo
  Equipo *-- Alumno
  Equipo --> LiderEquipo : posee
  Programa --> Gestor : es organizado
}

package MotorEvaluacion {
  class Convocatoria
  class CursoAcademico
  class Semestre
  class Candidato
  class Test
  class TestActitud
  class TestAptitud
  class TestTecnico
  class Resultado
  class Entrevista

  CursoAcademico *-- Semestre
  Convocatoria --> Semestre : organiza por
  Convocatoria o-- Candidato

  Candidato --> Test : realiza
  Test <|-- TestActitud
  Test <|-- TestAptitud
  Test <|-- TestTecnico
  Test o-- Resultado

  Candidato --> Entrevista : agenda
  Gestor --> Entrevista : realiza
}

package MotorFormacion {
  class Capacitacion
  class Modulo
  class Material
  class Entregable
  class Pregunta
  class PreguntaTeorica
  class PreguntaPractica

  Pregunta <|-- PreguntaTeorica
  Pregunta <|-- PreguntaPractica

  Capacitacion o-- Modulo
  Modulo *-- Material
  Modulo o-- Entregable
  Modulo o-- Pregunta
}

Programa --> Convocatoria : mantiene abierta
Gestor --> Resultado : consulta

TestTecnico ... Pregunta
Alumno ---> TestTecnico : realiza

Alumno --> Capacitacion : realiza
LiderEquipo --> Modulo : configura
LiderEquipo --> Capacitacion : evalua

@enduml
