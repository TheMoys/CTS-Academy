@startuml modeloDominio

!theme plain
hide empty members
hide circles
skinparam linetype polyline
left to right direction

package MotorEquipos {
  class Programa
  class Equipo 
  class Alumno
  class LiderEquipo
  class Gestor

  Programa *-- Equipo
  Equipo *-- Alumno
  Equipo --> LiderEquipo : posee
  Programa --> Gestor : es organizado
}

package MotorEvaluacion {
  class Convocatoria
  class CursoAcademico
  class Semestre
  class Candidato
  class Test
  class Actitud
  class Aptitud
  class Tecnico
  class Resultado
  class Entrevista

  CursoAcademico *-- Semestre
  Convocatoria --> Semestre : organiza por
  Convocatoria o-- Candidato

  Candidato --> Test : realiza
  Test <|-- Actitud
  Test <|-- Aptitud
  Test <|-- Tecnico
  Test o-- Resultado

  Candidato o-- Entrevista
  Gestor --> Entrevista : agenda
}

package MotorFormacion {
  class Capacitacion
  class Modulo
  class Material
  class Entregable
  class Pregunta
  class Teorica
  class Practica

  Pregunta <|-- Teorica
  Pregunta <|-- Practica

  Capacitacion o-- Modulo
  Modulo *-- Material
  Modulo o-- Entregable
  Modulo o-- Pregunta
}

Programa --> Convocatoria : mantiene abierta
Gestor --> Resultado : consulta

Test ... Pregunta
Alumno ---> Tecnico : realiza

Alumno --> Capacitacion : realiza
LiderEquipo --> Modulo : configura
LiderEquipo --> Capacitacion : evalua

@enduml
