@startuml modeloDominio

!theme plain
hide empty members
hide circles
skinparam linetype polyline

package MotorEvaluacion {
  class Convocatoria
  class CursoAcademico
  class Semestre
  class Candidato
  class Test
  class Actitud
  class Aptitud
  class Tecnico
  class Resultado
  class Entrevista

  CursoAcademico *-u- Semestre
  Convocatoria -r-> Semestre : organiza por
  Convocatoria o-- Candidato

  Candidato --> Test : realiza
  Test <|-- Actitud
  Test <|-- Aptitud
  Test <|-- Tecnico
  Test o-- Resultado

  Candidato *-- Entrevista
  Gestor --> Entrevista : agenda
  Gestor --> Resultado : consulta
}

package MotorEquipos {
  class Programa
  class Equipo 
  class Alumno
  class LiderEquipo
  class Gestor

  Programa *-- Equipo
  Equipo o-- Alumno
  Equipo --> LiderEquipo : posee
  Programa --> Gestor : es organizado
}

package MotorFormacion {
  class Capacitacion
  class Modulo
  class Material
  class Entregable
  class Pregunta
  class Teorica
  class Practica

  Pregunta <|-- Teorica
  Pregunta <|-- Practica

  Capacitacion o-- Material
  Modulo <-r- Material : se agrupa en
  Modulo o-- Entregable
  Material --> Pregunta : genera
  Alumno --> Capacitacion : realiza
  LiderEquipo --> Modulo : configura
  LiderEquipo --> Capacitacion : evalua
}

Candidato -- Alumno : > Cuando se acepta

Programa --> Convocatoria : mantiene abierta
Test ... Pregunta
Alumno ---> Tecnico : realiza

@enduml
