@startuml modeloDominio

!theme plain
hide empty members
hide circles
skinparam linetype polyline
left to right direction

package MotorEquipos {
  class Programa
  class Equipo 
  class Alumno
  class LiderEquipo
  class Gestor

  Programa *-- Equipo
  Equipo *-- Alumno
  Equipo --> LiderEquipo : posee
  Programa --> Gestor : es organizado
}

package MotorEvaluacion {
  class Convocatoria
  class Candidato
  class Test
  class Resultado

  Convocatoria o-- Candidato
  Candidato --> Test : realiza
  Test o-- Resultado
}

package MotorFormacion {
  class Capacitacion
  class Modulo
  class Material
  class Entregable
  class Pregunta
  class PreguntaTeorica
  class PreguntaPractica

  Pregunta <|-- PreguntaTeorica
  Pregunta <|-- PreguntaPractica

  Capacitacion o-- Modulo
  Modulo *-- Material
  Modulo o-- Entregable
  Modulo o-- Pregunta
}

Programa --> Convocatoria : abre
Gestor --> Resultado : evalua

Test ... Pregunta
Alumno ---> Test : realiza

Alumno --> Capacitacion : realiza
LiderEquipo --> Modulo : configura
LiderEquipo --> Capacitacion : evalua

@enduml
