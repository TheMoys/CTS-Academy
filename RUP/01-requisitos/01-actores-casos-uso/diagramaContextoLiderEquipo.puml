@startuml diagramaContextoLiderEquipo

!theme plain
left to right direction
skinparam state {
  BackgroundColor White
  BorderColor Black
  ArrowColor Black
}

state SESION_CERRADA
state PANEL_LIDER_ABIERTO
state EQUIPO_PROPIO_ABIERTO
state MODULO_CONFIGURACION_ABIERTO
state BANCO_PREGUNTAS_ABIERTO
state REVISION_ENTREGABLES_ABIERTO
state CONSULTA_ASPIRANTES_ABIERTO

[*] --> SESION_CERRADA

SESION_CERRADA --> SESION_CERRADA : iniciarSesion()
SESION_CERRADA --> PANEL_LIDER_ABIERTO : iniciarSesion()
PANEL_LIDER_ABIERTO --> SESION_CERRADA : cerrarSesion()

' Gestión de Equipo y Módulos
PANEL_LIDER_ABIERTO --> EQUIPO_PROPIO_ABIERTO : abrirEquipoPropio()
EQUIPO_PROPIO_ABIERTO --> PANEL_LIDER_ABIERTO : abrirPanelLider()
EQUIPO_PROPIO_ABIERTO --> EQUIPO_PROPIO_ABIERTO : evaluarCapacitacionAlumno()

EQUIPO_PROPIO_ABIERTO --> MODULO_CONFIGURACION_ABIERTO : configurarModulo()
MODULO_CONFIGURACION_ABIERTO --> MODULO_CONFIGURACION_ABIERTO : crearMaterial()
MODULO_CONFIGURACION_ABIERTO --> MODULO_CONFIGURACION_ABIERTO : editarMaterial()
MODULO_CONFIGURACION_ABIERTO --> MODULO_CONFIGURACION_ABIERTO : eliminarMaterial()
MODULO_CONFIGURACION_ABIERTO --> EQUIPO_PROPIO_ABIERTO : abrirEquipoPropio()

' Banco de reactivos técnicos
PANEL_LIDER_ABIERTO --> BANCO_PREGUNTAS_ABIERTO : crearPregunta()
BANCO_PREGUNTAS_ABIERTO --> BANCO_PREGUNTAS_ABIERTO : editarPregunta()
BANCO_PREGUNTAS_ABIERTO --> BANCO_PREGUNTAS_ABIERTO : eliminarPregunta()
BANCO_PREGUNTAS_ABIERTO --> PANEL_LIDER_ABIERTO : abrirPanelLider()

' Code Reviews de PRs y prácticas
PANEL_LIDER_ABIERTO --> REVISION_ENTREGABLES_ABIERTO : abrirEntregablesPendientes()
REVISION_ENTREGABLES_ABIERTO --> REVISION_ENTREGABLES_ABIERTO : revisarEntregable()
REVISION_ENTREGABLES_ABIERTO --> REVISION_ENTREGABLES_ABIERTO : aprobarEntregable()
REVISION_ENTREGABLES_ABIERTO --> REVISION_ENTREGABLES_ABIERTO : solicitarCambiosEntregable()
REVISION_ENTREGABLES_ABIERTO --> PANEL_LIDER_ABIERTO : abrirPanelLider()

' Consulta de aspirantes a su equipo
PANEL_LIDER_ABIERTO --> CONSULTA_ASPIRANTES_ABIERTO : consultarPerfilesCandidatos()
CONSULTA_ASPIRANTES_ABIERTO --> CONSULTA_ASPIRANTES_ABIERTO : consultarDetalleCandidato()
CONSULTA_ASPIRANTES_ABIERTO --> PANEL_LIDER_ABIERTO : abrirPanelLider()

@enduml
