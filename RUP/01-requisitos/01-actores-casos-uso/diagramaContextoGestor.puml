@startuml diagramaContextoGestor

!theme plain
left to right direction
skinparam state {
  BackgroundColor White
  BorderColor Black
  ArrowColor Black
}

state SESION_CERRADA
state PANEL_ADMISIONES_ABIERTO
state REGISTRO_CANDIDATO_ABIERTO
state PERFIL_CANDIDATO_ABIERTO
state GESTION_CICLOS_ABIERTO

[*] --> SESION_CERRADA

SESION_CERRADA --> SESION_CERRADA : iniciarSesion()
SESION_CERRADA --> PANEL_ADMISIONES_ABIERTO : iniciarSesion()
PANEL_ADMISIONES_ABIERTO --> SESION_CERRADA : cerrarSesion()

' Recepción y registro de aspirantes remitidos por sedes
PANEL_ADMISIONES_ABIERTO --> REGISTRO_CANDIDATO_ABIERTO : registrarCandidato()
REGISTRO_CANDIDATO_ABIERTO --> REGISTRO_CANDIDATO_ABIERTO : importarCandidatosSede()
REGISTRO_CANDIDATO_ABIERTO --> PANEL_ADMISIONES_ABIERTO : abrirPanelAdmisiones()

' Perfil del candidato: muestra resultados de tests, agenda Meet, notas y dictamen
PANEL_ADMISIONES_ABIERTO --> PERFIL_CANDIDATO_ABIERTO : abrirPerfilCandidato()
PERFIL_CANDIDATO_ABIERTO --> PERFIL_CANDIDATO_ABIERTO : agendarEntrevistaGoogleMeet()
PERFIL_CANDIDATO_ABIERTO --> PERFIL_CANDIDATO_ABIERTO : registrarAnotacionesEntrevista()
PERFIL_CANDIDATO_ABIERTO --> PANEL_ADMISIONES_ABIERTO : admitirAlumnoProfer()
PERFIL_CANDIDATO_ABIERTO --> PANEL_ADMISIONES_ABIERTO : rechazarCandidatura()
PERFIL_CANDIDATO_ABIERTO --> PANEL_ADMISIONES_ABIERTO : abrirPanelAdmisiones()

' Gobernanza de periodos académicos y cortes semestrales
PANEL_ADMISIONES_ABIERTO --> GESTION_CICLOS_ABIERTO : abrirPeriodoIngreso()
GESTION_CICLOS_ABIERTO --> GESTION_CICLOS_ABIERTO : cerrarCorteSemestral()
GESTION_CICLOS_ABIERTO --> PANEL_ADMISIONES_ABIERTO : abrirPanelAdmisiones()

@enduml
