@startuml actoresCasosUsoAlumno

!theme plain
left to right direction
skinparam packageStyle rectangle

actor Alumno

package "Acceso e Inicio" {
  usecase iniciarSesion as "iniciarSesion()"
  usecase cerrarSesion as "cerrarSesion()"
  usecase abrirInicio as "abrirInicio()"
}

package "Capacitación y Módulos" {
  usecase abrirCapacitacion as "abrirCapacitacion()"
  usecase abrirModulo as "abrirModulo()"
  usecase consultarMaterial as "consultarMaterial()"
  usecase consultarProgresoFormativo as "consultarProgresoFormativo()"
}

package "Entregables de Código" {
  usecase enviarEntregable as "enviarEntregable()"
  usecase consultarFeedbackEntregable as "consultarFeedbackEntregable()"
}

package "Nivelación y Cierre de Módulo" {
  usecase iniciarTestTecnicoNivelacion as "iniciarTestTecnicoNivelacion()"
  usecase responderPreguntaTeorica as "responderPreguntaTeorica()"
  usecase entregarPreguntaPractica as "entregarPreguntaPractica()"
  usecase finalizarTestTecnicoNivelacion as "finalizarTestTecnicoNivelacion()"
}

Alumno -- iniciarSesion
Alumno -- cerrarSesion
Alumno -- abrirInicio

Alumno -- abrirCapacitacion
Alumno -- abrirModulo
Alumno -- consultarMaterial
Alumno -- consultarProgresoFormativo

Alumno -- enviarEntregable
Alumno -- consultarFeedbackEntregable

Alumno -- iniciarTestTecnicoNivelacion
Alumno -- responderPreguntaTeorica
Alumno -- entregarPreguntaPractica
Alumno -- finalizarTestTecnicoNivelacion

@enduml
