@startuml diagramaContextoAlumno

!theme plain
left to right direction
skinparam state {
  BackgroundColor White
  BorderColor Black
  ArrowColor Black
}

state SESION_CERRADA
state INICIO_ALUMNO_ABIERTO
state CAPACITACION_ABIERTO
state MODULO_ABIERTO
state ENTREGABLE_ABIERTO
state TEST_NIVELACION_EN_EJECUCION

[*] --> SESION_CERRADA

SESION_CERRADA --> SESION_CERRADA : iniciarSesion()
SESION_CERRADA --> INICIO_ALUMNO_ABIERTO : iniciarSesion()
INICIO_ALUMNO_ABIERTO --> SESION_CERRADA : cerrarSesion()
INICIO_ALUMNO_ABIERTO --> INICIO_ALUMNO_ABIERTO : abrirPanelAlumno()

INICIO_ALUMNO_ABIERTO --> CAPACITACION_ABIERTO : consultarCapacitacion()
CAPACITACION_ABIERTO --> INICIO_ALUMNO_ABIERTO : abrirPanelAlumno()

CAPACITACION_ABIERTO --> MODULO_ABIERTO : consultarModulo()
MODULO_ABIERTO --> CAPACITACION_ABIERTO : consultarCapacitacion()
MODULO_ABIERTO --> MODULO_ABIERTO : consultarMaterial()

' Flujo de entregables y code reviews
MODULO_ABIERTO --> ENTREGABLE_ABIERTO : enviarEntregable()
ENTREGABLE_ABIERTO --> ENTREGABLE_ABIERTO : consultarFeedbackEntregable()
ENTREGABLE_ABIERTO --> MODULO_ABIERTO : consultarModulo()

' Test técnico de nivelación y fin de módulo
MODULO_ABIERTO --> TEST_NIVELACION_EN_EJECUCION : iniciarTest()
TEST_NIVELACION_EN_EJECUCION --> TEST_NIVELACION_EN_EJECUCION : responderPreguntaTeorica()
TEST_NIVELACION_EN_EJECUCION --> TEST_NIVELACION_EN_EJECUCION : entregarPreguntaPractica()
TEST_NIVELACION_EN_EJECUCION --> MODULO_ABIERTO : finalizarTest()

@enduml
