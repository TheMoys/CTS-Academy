@startuml actoresCasosUsoGestor

!theme plain
left to right direction
skinparam packageStyle rectangle

actor UsuarioNoLogueado
actor Gestor

package "Acceso" {
  usecase iniciarSesion as "iniciarSesion()"
  usecase cerrarSesion as "cerrarSesion()"
  usecase abrirPanelAdmisiones as "abrirPanelAdmisiones()"
}

UsuarioNoLogueado -- iniciarSesion
Gestor -- cerrarSesion
Gestor -- abrirPanelAdmisiones
abrirPanelAdmisiones ..> iniciarSesion : <<extend>>\n(condición: rol == Gestor)\n(punto: tras validación exitosa)

package "Recepción y Registro de Candidatos" {
  usecase registrarCandidato as "registrarCandidato()"
  usecase importarCandidatosSede as "importarCandidatosSede()"
}

package "Gestión del Perfil del Candidato" {
  usecase abrirPerfilCandidato as "abrirPerfilCandidato()"
  usecase agendarEntrevistaGoogleMeet as "agendarEntrevistaGoogleMeet()"
  usecase registrarAnotacionesEntrevista as "registrarAnotacionesEntrevista()"
  usecase admitirAlumnoProfer as "admitirAlumnoProfer()"
  usecase rechazarCandidatura as "rechazarCandidatura()"
}

package "Gobernanza y Ciclos" {
  usecase abrirPeriodoIngreso as "abrirPeriodoIngreso()"
  usecase cerrarCorteSemestral as "cerrarCorteSemestral()"
}

Gestor -- registrarCandidato
Gestor -- importarCandidatosSede

Gestor -- abrirPerfilCandidato
Gestor -- agendarEntrevistaGoogleMeet
Gestor -- registrarAnotacionesEntrevista
Gestor -- admitirAlumnoProfer
Gestor -- rechazarCandidatura

Gestor -- abrirPeriodoIngreso
Gestor -- cerrarCorteSemestral

@enduml
