@startuml actoresCasosUsoCandidato

!theme plain
left to right direction
skinparam packageStyle rectangle

actor UsuarioNoLogueado
actor Candidato

package "Acceso" {
  usecase iniciarSesion as "iniciarSesion()"
  usecase cerrarSesion as "cerrarSesion()"
  usecase abrirPanelPostulacion as "abrirPanelPostulacion()"
}

UsuarioNoLogueado -- iniciarSesion
Candidato -- cerrarSesion
Candidato -- abrirPanelPostulacion
abrirPanelPostulacion ..> iniciarSesion : <<extend>>\n(condición: rol == Candidato)\n(punto: tras validación exitosa)

package "Batería de Tests" {
  usecase iniciarTest as "iniciarTest()"
  usecase responderPreguntaTeorica as "responderPreguntaTeorica()"
  usecase entregarPreguntaPractica as "entregarPreguntaPractica()"
  usecase finalizarTest as "finalizarTest()"
}

Candidato -- iniciarTest
Candidato -- responderPreguntaTeorica
Candidato -- entregarPreguntaPractica
Candidato -- finalizarTest

@enduml
