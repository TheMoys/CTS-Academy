@startuml clasesAnalisis
skinparam style strictuml
skinparam classAttributeIconSize 0

class Gestor <<actor>>

class DialogoAperturaConvocatoria <<boundary>> {
    + presentarFormulario(cursos: List<CursoAcademico>, semestres: List<Semestre>, equipos: List<Equipo>)
    + capturarDatosConvocatoria(datos: DatosAperturaDTO)
    + mostrarErrorValidacionFechas(mensaje: String)
    + mostrarErrorCuposInvalidos(mensaje: String)
    + mostrarConfirmacionApertura(convocatoria: Convocatoria)
}

class GestorCiclosAcademicos <<control>> {
    + obtenerCatalogosCiclos(): ParametrosAperturaDTO
    + validarRangoFechasUTC(inicio: DateTime, fin: DateTime): Boolean
    + validarCuotas6Equipos(cupos: Map<UUID, Integer>): Boolean
    + registrarAperturaConvocatoria(datos: DatosAperturaDTO): Convocatoria
}

class Gestor <<entity>> {
    - id: UUID
    - nombreCompleto: String
    - email: String
    - rol: RolUsuario
    + tienePermisoAdministracion(): Boolean
}

class CursoAcademico <<entity>> {
    - id: UUID
    - denominacion: String
    - anioInicio: Integer
    - anioFin: Integer
    - activo: Boolean
    + esVigente(): Boolean
}

class Semestre <<entity>> {
    - id: UUID
    - idCursoAcademico: UUID
    - periodo: TipoSemestre
    - fechaInicio: Date
    - fechaFin: Date
    + esPeriodoValido(): Boolean
}

class Convocatoria <<entity>> {
    - id: UUID
    - denominacion: String
    - idCursoAcademico: UUID
    - idSemestre: UUID
    - estadoConvocatoria: EstadoConvocatoria
    - fechaApertura: DateTime
    - fechaCierre: DateTime
    - modeloAdmision: ModeloAdmision
    + activarConvocatoria(): Void
    + validarPlazoAdmisionContinua(): Boolean
}

class Equipo <<entity>> {
    - id: UUID
    - nombre: String
    - codigo: String
    - cupoMaximoDefecto: Integer
}

class CupoEquipoConvocatoria <<entity>> {
    - id: UUID
    - idConvocatoria: UUID
    - idEquipo: UUID
    - cupoAsignado: Integer
    + validarCupoMayorACero(): Boolean
}

Gestor --> DialogoAperturaConvocatoria : interactúa con
DialogoAperturaConvocatoria --> GestorCiclosAcademicos : invoca
GestorCiclosAcademicos --> Gestor : verifica rol
GestorCiclosAcademicos --> CursoAcademico : valida curso [RN-PER-01]
GestorCiclosAcademicos --> Semestre : valida semestre [RN-PER-01]
GestorCiclosAcademicos --> Equipo : consulta 6 squads
GestorCiclosAcademicos --> Convocatoria : crea en estado ABIERTO [RN-PER-03]
GestorCiclosAcademicos --> CupoEquipoConvocatoria : fija cuotas de plazas [RN-PER-02]
@enduml
