@startuml clasesAnalisis
skinparam style strictuml
skinparam classAttributeIconSize 0

class Gestor <<actor>>

class PanelAdmisiones <<boundary>> {
    + presentarDashboard(resumen: ResumenAdmisionesDTO)
    + mostrarKpisConvocatoria(kpis: MetricasAdmisionDTO)
    + mostrarOcupacionEquipos(ocupaciones: List<OcupacionEquipoDTO>)
    + mostrarTablaCandidatos(candidatos: List<Candidato>)
    + filtrarCandidatos(criterios: CriteriosFiltroDTO)
    + navegarHaciaPerfilCandidato(idCandidato: UUID)
    + navegarHaciaGestionCiclos()
}

class GestorAdmisiones <<control>> {
    + obtenerResumenAdmisiones(): ResumenAdmisionesDTO
    + calcularMetricasConvocatoria(idConvocatoria: UUID): MetricasAdmisionDTO
    + calcularOcupacionTodosEquipos(): List<OcupacionEquipoDTO>
    + listarCandidatosHolistico(filtro: CriteriosFiltroDTO): List<Candidato>
}

class Gestor <<entity>> {
    - id: UUID
    - nombreCompleto: String
    - email: String
    - rol: RolUsuario
}

class Convocatoria <<entity>> {
    - id: UUID
    - denominacion: String
    - estadoConvocatoria: EstadoConvocatoria
    - fechaApertura: DateTime
    - fechaCierre: DateTime
    + esActiva(): Boolean
}

class Equipo <<entity>> {
    - id: UUID
    - nombre: String
    - codigo: String
    - sede: Sede
    - cupoMaximo: Integer
    - totalAdmitidos: Integer
    + calcularTasaOcupacion(): Porcentaje
    + tienePlazasDisponibles(): Boolean
}

class Candidato <<entity>> {
    - id: UUID
    - nombre: String
    - apellidos: String
    - email: String
    - sedeOrigen: Sede
    - idConvocatoria: UUID
    - idEquipoAsignado: UUID
    - estadoPostulacion: EstadoPostulacion
    - notaFinalBateria: Calificacion
    - decisionAdmision: DecisionAdmision
    + obtenerEstadoActual(): EstadoPostulacion
}

Gestor --> PanelAdmisiones : interactúa con
PanelAdmisiones --> GestorAdmisiones : invoca
GestorAdmisiones --> Gestor : verifica permisos
GestorAdmisiones --> Convocatoria : consulta convocatoria activa
GestorAdmisiones --> Equipo : calcula ocupación 6 squads [RN-ADM-DASH-01]
GestorAdmisiones --> Candidato : consulta holística multisucursal [RN-ADM-DASH-02]
@enduml
